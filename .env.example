# Application
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-long-random-secret-key-min-32-chars
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=postgresql://ashenta:ashenta_pass@localhost:5432/ashenta_db

# Security
JWT_SECRET_KEY=change-this-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Encryption key for camera credentials (Fernet 32-byte base64)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-this-to-fernet-key

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stream token expiry (seconds)
STREAM_TOKEN_EXPIRE_SECONDS=3600

# YOLOv8 model path (auto-downloaded if not set)
YOLO_MODEL_PATH=yolov8n.pt

# yt-dlp YouTube authentication (required to avoid bot-detection on YouTube streams)
# Option 1: path to a Netscape-format cookies.txt exported from your browser
#   Export with the "Get cookies.txt LOCALLY" Chrome/Firefox extension
YT_DLP_COOKIES_FILE=

# Option 2: let yt-dlp pull cookies directly from an installed browser
#   Valid values: chrome, firefox, edge, safari, brave, opera, chromium, vivaldi
YT_DLP_COOKIES_FROM_BROWSER=

# Logging
LOG_LEVEL=INFO
